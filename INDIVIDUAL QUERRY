use crownfield_eye_hospital;
SELECT 

    d.DoctorName, 

    COUNT(pr.PrescriptionID) AS TotalPrescriptions 

FROM Doctor d 

LEFT JOIN Prescription pr 

    ON d.DoctorID = pr.DoctorID 

GROUP BY d.DoctorID, d.DoctorName; 








