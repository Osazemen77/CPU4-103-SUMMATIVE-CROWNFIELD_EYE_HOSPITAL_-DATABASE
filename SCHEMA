USE crownfield_eye_hospital;
  
CREATE TABLE Department (
    DepartmentID INT AUTO_INCREMENT,
    DepartmentName VARCHAR(100) NOT NULL,

    PRIMARY KEY (DepartmentID)
);

  TABLE: Room
  PRIMARY KEY: RoomNumber


CREATE TABLE Room (
    RoomNumber INT,
    RoomRate DECIMAL(10,2) NOT NULL,

    PRIMARY KEY (RoomNumber)
);


  TABLE: Patient

  PRIMARY KEY:
      PatientID

  FOREIGN KEYS:
      RoomNumber → Room(RoomNumber)
      DepartmentID → Department(DepartmentID)


CREATE TABLE Patient (
    PatientID INT AUTO_INCREMENT,
    PatientName VARCHAR(100) NOT NULL,
    RoomNumber INT NOT NULL,
    DepartmentID INT NOT NULL,

    PRIMARY KEY (PatientID),

    CONSTRAINT FK_Patient_Room
        FOREIGN KEY (RoomNumber)
        REFERENCES Room(RoomNumber),

    CONSTRAINT FK_Patient_Department
        FOREIGN KEY (DepartmentID)
        REFERENCES Department(DepartmentID)
);


  TABLE: Doctor

  PRIMARY KEY:
      DoctorID


CREATE TABLE Doctor (
    DoctorID INT AUTO_INCREMENT,
    DoctorName VARCHAR(100) NOT NULL,
    Specialty VARCHAR(100) NOT NULL,

    PRIMARY KEY (DoctorID)
);


  TABLE: Medication

  PRIMARY KEY:
      MedicationID


CREATE TABLE Medication (
    MedicationID INT AUTO_INCREMENT,
    MedicationName VARCHAR(100) NOT NULL,

    PRIMARY KEY (MedicationID)
);


  TABLE: Prescription

  PRIMARY KEY:
      PrescriptionID

  FOREIGN KEYS:
      PatientID → Patient(PatientID)
      DoctorID → Doctor(DoctorID)
      MedicationID → Medication(MedicationID)


CREATE TABLE Prescription (
    PrescriptionID INT AUTO_INCREMENT,
    PatientID INT NOT NULL,
    DoctorID INT NOT NULL,
    MedicationID INT NOT NULL,

    PRIMARY KEY (PrescriptionID),

    CONSTRAINT FK_Prescription_Patient
        FOREIGN KEY (PatientID)
        REFERENCES Patient(PatientID),

    CONSTRAINT FK_Prescription_Doctor
        FOREIGN KEY (DoctorID)
        REFERENCES Doctor(DoctorID),

    CONSTRAINT FK_Prescription_Medication
        FOREIGN KEY (MedicationID)
        REFERENCES Medication(MedicationID)
);

